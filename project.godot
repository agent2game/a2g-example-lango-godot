[layer_names]

2d_render/layer_1="World"
2d_render/layer_2="Player"
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="PlayerHurtBox"
2d_physics/layer_4="EnemyHurtBox"
2d_physics/layer_5="Enemy"
2d_physics/layer_6="Cave"
2d_physics/layer_7="PlayerHitBox"
2d_physics/layer_8="EnemyHitBox"
2d_physics/layer_9="Bomb"

[internationalization]

locale/translations=PackedStringArray("res://Translation/language.en_US.translation", "res://Translation/language.pt_BR.translation", "res://Translation/language.es.translation")
locale/fallback="en_US"

[rendering]

environment/defaults/default_environment="res://default_env.tres"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
vram_compression/import_etc=true

[editor_plugins]

enabled=PackedStringArray("res://addons/a2g/plugin.cfg")
